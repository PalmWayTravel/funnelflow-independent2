{
  "name": "Lead",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account"
    },
    "client_id": {
      "type": "string",
      "title": "Client"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "source": {
      "type": "string",
      "enum": [
        "Meta Ads",
        "Website",
        "Referral",
        "Other"
      ],
      "default": "Website",
      "title": "Source"
    },
    "stage": {
      "type": "string",
      "enum": [
        "New Lead",
        "Contacted",
        "Proposal",
        "Negotiation",
        "Won",
        "Lost"
      ],
      "default": "New Lead",
      "title": "Stage"
    },
    "value": {
      "type": "number",
      "default": 0,
      "title": "Estimated Value"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Activity Log"
    }
  },
  "required": [
    "client_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}