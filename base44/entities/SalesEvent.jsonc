{
  "name": "SalesEvent",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account"
    },
    "type": {
      "type": "string",
      "enum": [
        "lead",
        "booked",
        "held",
        "noshow",
        "cancel",
        "quote",
        "signed",
        "closed",
        "payment",
        "refund"
      ],
      "title": "Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "contact_id": {
      "type": "string",
      "title": "Kontakt"
    },
    "booking_id": {
      "type": "string",
      "title": "Foglal\u00e1s"
    },
    "setter_id": {
      "type": "string",
      "title": "Setter"
    },
    "closer_id": {
      "type": "string",
      "title": "Closer"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "title": "Amount"
    },
    "setup_fee": {
      "type": "number",
      "default": 0,
      "title": "Setup Fee"
    },
    "monthly_fee": {
      "type": "number",
      "default": 0,
      "title": "Monthly Fee"
    },
    "sales_cycle_days": {
      "type": "number",
      "title": "Sales Cycle Days"
    }
  },
  "required": [
    "type",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}