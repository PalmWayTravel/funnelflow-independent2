{
  "name": "Offer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Csomag neve"
    },
    "description": {
      "type": "string",
      "title": "R\u00f6vid le\u00edr\u00e1s"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Tartalom (felsorol\u00e1s)"
    },
    "setup_fee": {
      "type": "number",
      "default": 0,
      "title": "Setup d\u00edj (Ft)"
    },
    "monthly_fee": {
      "type": "number",
      "default": 0,
      "title": "Havi d\u00edj (Ft)"
    },
    "contract_template": {
      "type": "string",
      "title": "Szerz\u0151d\u00e9s sz\u00f6vege (sablon)"
    },
    "payment_url": {
      "type": "string",
      "title": "Fizet\u00e9si link (opcion\u00e1lis)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Akt\u00edv"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sorrend"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}