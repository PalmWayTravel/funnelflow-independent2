      "title": "Client"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "file_type": {
      "type": "string",
      "title": "File Type"
    },
    "file_size": {
      "type": "number",
      "title": "File Size"
    },
    "uploaded_by_id": {
      "type": "string",
      "title": "Uploaded By"
    }
  },
  "required": [
